---

<section id='connect'>
  <header>
    <h2>Let's talk.</h2>
    <p>
      I'm always up for a good conversation. Whether it's {job && 'a job opening, '} a collab, a proof that refuses to close,
      an argument about code, or a question that doesn't have a clean answer - I'm in.
      <span> Dox me if you feel like it, though I wouldn't recommend it.</span>
    </p>
  </header>

  <ul>
    {
      links.map(({ name, icon, url, color }) => (
        <li>
          <a href={url} target='_blank' rel='noopener noreferrer'>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              viewBox='0 0 24 24'
              stroke='none'
              fill='currentColor'
              focusable='false'
              style={{ color }}
              data-name={name}
              aria-hidden='true'
            >
              <path d={icon} />
            </svg>
            <h3>{name}</h3>
          </a>
        </li>
      ))
    }
  </ul>

  <p>The email above is an alias - it might change. If it stops working, you'll know why.</p>
</section>

<script>
  const grid = document.querySelector('#connect>ul')!,
    items = Array.from(grid.children) as HTMLElement[],
    unhider = document.querySelector('#connect>header>p>span')!;

  let unhidden = false;
  new ResizeObserver(() => {
    if (unhidden) return;

    const cols = window.getComputedStyle(grid).gridTemplateColumns.split(' ').length;
    items.forEach((item, i) => (item.style.display = i < cols ? '' : 'none'));
  }).observe(grid);

  unhider.addEventListener('click', () =>
    items.forEach(item => {
      item.style.display = '';
      unhidden = true;
    }),
  );
</script>
