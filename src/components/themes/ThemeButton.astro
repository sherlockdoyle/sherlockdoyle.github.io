---
import { moreThemes, themes } from './themes';
---

<button id='theme' command='show-modal' commandfor='theme-dialog'>Theme</button>

<dialog id='theme-dialog' closedby='any' aria-labelledby='theme-dialog-title'>
  <header>
    <h2 id='theme-dialog-title'>Themes</h2>

    <button command='close' commandfor='theme-dialog'>Close</button>
  </header>

  <fieldset>
    <legend>The page will reload in a flash.</legend>
    {
      themes.map((theme, i) =>
        typeof theme === 'string' ? (
          <label class:list={['col1', i && 'bt']} style={{ gridRow: i + 1 }}>
            <input type='radio' name='theme' value={theme} />
            {theme}
          </label>
        ) : (
          <>
            <label class:list={['col1', i && 'bt']} style={{ gridRow: i + 1 }}>
              <input type='radio' name='theme' value={theme[0]} />
              {theme[0]}
            </label>
            <label class:list={['col2', i && 'bt']} style={{ gridRow: i + 1 }}>
              <input type='radio' name='theme' value={theme[1]} />
              {theme[1]}
            </label>
          </>
        ),
      )
    }
    {
      moreThemes.map((theme, i) => (
        <label class:list={['col3', i && 'bt']} style={{ gridRow: i + 1 }}>
          <input type='radio' name='theme' value={theme} />
          {theme}
        </label>
      ))
    }
  </fieldset>
</dialog>

<script>
  import { type Theme } from './themes';

  declare global {
    interface Window {
      __theme: Theme;
    }
  }

  const actions: Partial<Record<Theme, () => void>> = {
    cartUnI: () => import('./logic/cartuni'),
    'cartUnI dark': () => import('./logic/cartuni'),
    Matrix: () => import('./logic/matrix'),
    undefined: () => import('./logic/undefined'),
    Normal: () => import('./logic/normal'),
    Antigravity: () => import('./logic/antigravity'),
    'The roof is lava': () => import('./logic/the-roof-is-lava'),
  };

  const theme: Theme = window.__theme;
  actions[theme]?.();

  const fieldset = document.querySelector<HTMLFieldSetElement>('#theme-dialog>fieldset')!;
  fieldset.addEventListener('change', e => {
    const target = e.target as HTMLInputElement | null;
    if (target && target.name === 'theme') {
      const searchParams = new URLSearchParams(window.location.search);
      searchParams.set('t', target.value);
      window.location.search = searchParams.toString();
    }
  });
  fieldset.querySelector<HTMLInputElement>(`input[name='theme'][value='${theme}']`)!.checked = true;

  const url = new URL(window.location.href);
  url.searchParams.delete('t');
  window.history.replaceState(null, '', url);
</script>
