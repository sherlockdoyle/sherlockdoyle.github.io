---
import { KEY, moreThemes, themes } from './themes';
---

<script is:inline define:vars={{ KEY, themes: themes.flat(), moreThemes }}>
  /** @import { Theme } from './themes' */

  /** @type {Theme | null} */
  let theme = null;
  function getSystemTheme() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark null' : 'null';
  }

  /** @type {Theme[]} */
  let seen = [];
  const data = localStorage.getItem(KEY);
  if (data)
    try {
      const parsed = JSON.parse(data);
      if (Array.isArray(parsed) && parsed.every(t => typeof t === 'string')) {
        seen = parsed;
        if (seen.length < 2) theme = getSystemTheme();
      } else theme = getSystemTheme();
    } catch {
      theme = getSystemTheme();
    }
  else theme = 'undefined';

  const queryTheme = new URLSearchParams(window.location.search).get('t');
  if (themes.includes(queryTheme) || moreThemes.includes(queryTheme)) theme = queryTheme;

  if (!theme) {
    const availableThemes = themes.filter(t => !seen.includes(t));
    theme = availableThemes[Math.floor(Math.random() * availableThemes.length)];
  }

  seen.unshift(theme);
  seen.length = Math.min(seen.length, Math.floor(themes.length * 0.75));
  localStorage.setItem(KEY, JSON.stringify(seen));

  /** @type {Partial<Record<Theme, string>>} */
  const themeCss = {
      null: 'null',
      'dark null': 'null-dark',
      Résumé: 'resume',
      Neon: 'neon',
      Matrix: 'matrix',
      lighter: 'lighter',
      darker: 'darker',
      'Barrel Roll': 'barrel-roll',
      'The roof is lava': 'lava-roof',
    },
    /** @type {Theme[]} */
    baseless = ['undefined', 'Résumé'];

  if (!baseless.includes(theme)) {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/themes/base.css';
    document.head.appendChild(link);
  }

  const css = themeCss[theme];
  if (css) {
    const style = document.createElement('style');
    style.textContent = `@import url('/themes/${css}.css') layer(theme);`;
    style.onload = style.onerror = () => (document.body.style.opacity = '');
    document.head.appendChild(style);
  } else document.addEventListener('DOMContentLoaded', () => (document.body.style.opacity = ''));

  window.__theme = theme;
</script>
