---
import ThemeLoader from '../components/themes/ThemeLoader.astro';

interface Props {
  nojs?: boolean;
}
const { nojs } = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' href='/avatar.png' />
    <link rel='preload' href='https://fonts.cdnfonts.com/css/satoshi' as='style' />
    <title>ME... SD</title>
    <meta
      name='description'
      content='Shekhar Dutta - full stack developer. I build productivity tools by day and weird side projects by night: games, compilers, libraries, and everything in between.'
    />
    <meta property='og:title' content='Sherlock Doyle · Portfolio' />
    <meta
      property='og:description'
      content='Full stack developer. Building things for fun - games, tools, libraries, and the occasional programming language.'
    />
    <meta property='og:type' content='website' />
    <meta property='og:url' content='https://sherlockdoyle.github.io/' />
    <meta property='og:image' content='/avatar.png' />
    <meta name='twitter:card' content='summary' />
    <meta name='twitter:creator' content='@SherlockDoyle4' />
    <style is:inline>
      @layer reset, base, theme;
    </style>
    {
      nojs ? (
        <>
          <link rel='stylesheet' href='/themes/nojs.css' />
          <script is:inline>window.location.replace('/');</script>
        </>
      ) : (
        <>
          <ThemeLoader />
          <noscript>
            <meta http-equiv='refresh' content='0; url=/nojs' />
          </noscript>
        </>
      )
    }
  </head>

  <body style={nojs ? undefined : { opacity: 0 }}>
    <slot />
  </body>
</html>

<style is:global>
  @import url('https://fonts.cdnfonts.com/css/satoshi');

  @layer reset {
    html,
    body {
      font-family: 'Satoshi', sans-serif;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
        transition: none !important;
      }
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation: none !important;
      }
    }
  }
</style>
