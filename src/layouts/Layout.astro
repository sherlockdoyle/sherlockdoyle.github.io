---
import { KEY, moreThemes, themes } from '../components/themes/themes';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' href='/avatar.png' />
    <link rel='preload' href='https://fonts.cdnfonts.com/css/satoshi' as='style' />
    <title>ME... SD</title>
    <meta
      name='description'
      content='Shekhar Dutta - full stack developer. I build productivity tools by day and weird side projects by night: games, compilers, libraries, and everything in between.'
    />
    <meta property='og:title' content='Sherlock Doyle · Portfolio' />
    <meta
      property='og:description'
      content='Full stack developer. Building things for fun - games, tools, libraries, and the occasional programming language.'
    />
    <meta property='og:type' content='website' />
    <meta property='og:url' content='https://sherlockdoyle.github.io/' />
    <meta property='og:image' content='/avatar.png' />
    <meta name='twitter:card' content='summary' />
    <meta name='twitter:creator' content='@SherlockDoyle4' />
    <style is:inline>
      @layer reset, base, theme;
    </style>
    <script
      is:inline
      define:vars={{ KEY, themes: themes.flat(), moreThemes: moreThemes.filter(t => t !== 'undefined') }}
    >
      /** @import { Theme } from '../components/themes/themes' */

      /** @type {Theme | null} */
      let theme = null;
      function getSystemTheme() {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark null' : 'null';
      }

      /** @type {Theme[]} */
      let seen = [];
      const data = localStorage.getItem(KEY);
      if (data)
        try {
          const parsed = JSON.parse(data);
          if (Array.isArray(parsed) && parsed.every(t => typeof t === 'string')) {
            seen = parsed;
            if (seen.length < 2) theme = getSystemTheme();
          } else theme = getSystemTheme();
        } catch {
          theme = getSystemTheme();
        }
      else theme = 'undefined';

      const queryTheme = new URLSearchParams(window.location.search).get('t');
      if (queryTheme === 'undefined' || themes.includes(queryTheme) || moreThemes.includes(queryTheme))
        theme = queryTheme;

      if (!theme) {
        const availableThemes = themes.filter(t => !seen.includes(t)),
          a = availableThemes.length;
        if (a) {
          const availableMore = moreThemes.filter(t => !seen.includes(t)),
            b = availableMore.length;
          const available = Math.random() > (a + b) / (a + 2 * b) ? availableMore : availableThemes;
          theme = available[Math.floor(Math.random() * available.length)];
        } else theme = getSystemTheme();
      }

      seen.unshift(theme);
      seen.length = Math.min(seen.length, Math.floor((themes.length + moreThemes.length) * 0.75));
      localStorage.setItem(KEY, JSON.stringify(seen));

      /** @type {Partial<Record<Theme, string>>} */
      const themeCss = {
          null: 'null',
          'dark null': 'null-dark',
          Résumé: 'resume',
          Neon: 'neon',
          Matrix: 'matrix',
          lighter: 'lighter',
          darker: 'darker',
          'Barrel Roll': 'barrel-roll',
        },
        /** @type {Theme[]} */
        baseless = ['undefined', 'Résumé'];

      if (!baseless.includes(theme)) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/themes/base.css';
        document.head.appendChild(link);
      }

      const css = themeCss[theme];
      if (css) {
        const style = document.createElement('style');
        style.textContent = `@import url('/themes/${css}.css') layer(theme);`;
        style.onload = style.onerror = () => (document.body.style.opacity = '');
        document.head.appendChild(style);
      } else document.addEventListener('DOMContentLoaded', () => (document.body.style.opacity = ''));

      window.__theme = theme;
    </script>
  </head>
  <body style={{ opacity: 0 }}>
    <slot />
  </body>
</html>

<style is:global>
  @import url('https://fonts.cdnfonts.com/css/satoshi');

  @layer reset {
    html,
    body {
      font-family: 'Satoshi', sans-serif;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
        transition: none !important;
      }
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation: none !important;
      }
    }
  }
</style>
