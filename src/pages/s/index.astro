<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' href='/avatar.png' />
    <title>Secret Diary</title>
  </head>

  <body>
    <noscript><p><em>You need JavaScript to decrypt the secrets.</em></p></noscript>

    <p>
      You have found the hidden layer. The other side is built to be seen, but I have a habit of leaving things for
      those who look closely. This space is a repository for thoughts, observations, and entries meant for specific
      people - a quiet corner away from the public eye.
    </p>
    <p>
      There is no index here. Access requires knowing the right key. I might have written something about you, <strong
        >enter your name</strong
      > below to find out. Use only lowercase letters, without any spaces (just a-z). Try variations: your first name, the
      name I usually call you by, or how I might have saved your contact.
    </p>

    <form class='input-area'>
      <input name='name' type='text' placeholder='Enter name...' spellcheck='false' autocomplete='off' />
      <button type='submit'>Load</button>
    </form>
    <hr />
    <div id='result'></div>
  </body>
</html>

<script>
  import { parse } from 'tiny-markdown-parser';
  import { decrypt, encrypt, fromBase38, toBase38 } from '../../utils/coder';

  const result = document.getElementById('result')!;
  async function loadMd(path_38: string, pass: string) {
    result.textContent = 'Loading...';

    const res = await fetch(`/s/${path_38}`);
    if (!res.ok) {
      result.textContent = 'Error: Nothing was found for that.';
      return;
    }

    const md = decrypt(await res.text(), pass);
    const html = parse(md);
    result.innerHTML = html;
    result.scrollTo({ top: 0, behavior: 'smooth' });
  }

  const url = new URL(window.location.href);
  const key = url.searchParams.keys().next().value;
  if (key) {
    const [key_38, from] = key.split('~');
    const value_38 = url.searchParams.get(key);
    if (value_38) loadMd(key_38, fromBase38(value_38));

    url.searchParams.delete(key);
    window.history.replaceState(null, '', url);

    const p = document.createElement('p');
    p.textContent = `Looks like you came from ${decrypt(fromBase38(from), key_38)}. Welcome to my secrets!`;
    document.body.prepend(p);
  }

  const form = document.forms[0];
  form.addEventListener('submit', e => {
    e.preventDefault();
    const val = new FormData(form).get('name') as string;
    if (val) {
      const name = encrypt(val, val);
      loadMd(toBase38(name), encrypt(name, val));
    }
  });
</script>

